# dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Downloaded model weights — fetched with:
#   python -m monai.bundle download --name brats_mri_segmentation --bundle_dir backend/models
backend/models/

# Generated test studies — recreate with: python backend/make_testcase.py
backend/testdata/

# Live server job directories — uploads/results, deleted automatically after 23h
backend/.runtime/

# Decathlon download + converted per-case volumes — recreate with:
#   python backend/tools/convert_decathlon.py --out backend/data
# or, for a small real sample instead of the full 7.6 GB archive:
#   python backend/tools/fetch_decathlon_sample.py --out backend/data/raw_sample
# (manifest.json and decathlon_split.json are small and stay tracked)
backend/data/raw/
backend/data/raw_sample/
backend/data/decathlon/

# Imaging data must never be committed
*.nii
*.nii.gz
*.dcm

# secrets / local env
.env
.env.*
!.env.example

.DS_Store
Thumbs.db
